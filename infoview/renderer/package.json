        "es-module-lexer": "1.5.4",
        "es-module-shims": "2.8.0",
        "highlightjs-lean": "1.2.0",
        "mathjax-full": "3.2.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-fast-compare": "3.2.2",
        "react-markdown": "9.0.1",
        "react-syntax-highlighter": "15.6.6",
        "rehype-mathjax": "7.1.0",
        "remark-math": "6.0.0",
