{
    "name": "@leanprover/infoview",
    "description": "An interactive display for the Lean 4 theorem prover.",
    "repository": {
        "type": "git",
        "url": "https://github.com/leanprover/vscode-lean4.git"
    },
    "type": "module",
    "license": "Apache-2.0",
